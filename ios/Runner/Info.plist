<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Calvi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>calvi</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Відповідь на питання про експорт шифрування, дана наперед.

	     Без цього рядка кожна збірка в App Store Connect стає «Missing
	     Compliance» і не роздається тестувальникам, поки хтось не відповість на
	     те саме питання руками. Відповідь тут: застосунок шифрує тільки тим,
	     що дає сама система, тобто HTTPS, а такий випадок Apple звільняє від
	     звітності. Якби зʼявилось власне шифрування даних, рядок довелось би
	     прибрати і подати звіт. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Навіщо застосунок просить камеру, мікрофон і галерею.

	     На iOS без цих рядків застосунок не питає дозволу, а падає на першому ж
	     зверненні, і рев'ю відхиляє збірку. Текст бачить людина в системному
	     вікні, тому він написаний для неї: сказано, що саме береться і навіщо.

	     Англійською, хоч застосунок і український. iOS бере ці рядки з файлу як
	     є, нічого не перекладаючи, і той самий текст читає рев'ювер Apple.
	     Українською він побачив би слова, яких не розуміє, і мав би повне право
	     сказати, що призначення дозволу не пояснене. -->
	<key>NSCameraUsageDescription</key>
	<string>Calvi uses the camera to photograph a meal or scan a barcode. The picture is analysed and never stored, on this phone or on our servers.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Calvi uses the microphone so you can dictate what you ate instead of typing it. Your phone turns the speech into text itself, and the audio is never sent to us.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Calvi opens your photo library so you can pick a picture of a meal you have already taken.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Calvi uses speech recognition to turn what you dictate into the text of a diary entry.</string>
</dict>
</plist>
