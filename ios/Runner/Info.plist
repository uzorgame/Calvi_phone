<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Calvi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>calvi</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Відповідь на питання про експорт шифрування, дана наперед.

	     Без цього рядка кожна збірка в App Store Connect стає «Missing
	     Compliance» і не роздається тестувальникам, поки хтось не відповість на
	     те саме питання руками. Відповідь тут: застосунок шифрує тільки тим,
	     що дає сама система, тобто HTTPS, а такий випадок Apple звільняє від
	     звітності. Якби зʼявилось власне шифрування даних, рядок довелось би
	     прибрати і подати звіт. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Навіщо застосунок просить камеру, мікрофон і галерею.

	     На iOS без цих рядків застосунок не питає дозволу, а падає на першому ж
	     зверненні, і рев'ю відхиляє збірку. Текст бачить людина в системному
	     вікні, тому він написаний для неї, а не для перевіряльника: сказано, що
	     саме береться і навіщо. -->
	<key>NSCameraUsageDescription</key>
	<string>Щоб сфотографувати страву або зчитати штрихкод. Знімок не зберігається ні на телефоні, ні в нас.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Щоб надиктувати, що ви з'їли, замість набирати. Розпізнає мову сам телефон, звук нам не надсилається.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Щоб узяти вже готове фото страви з галереї.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Щоб перетворити надиктоване на текст запису.</string>
</dict>
</plist>
